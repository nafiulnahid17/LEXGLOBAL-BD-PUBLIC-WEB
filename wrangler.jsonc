{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lexglobalbd-public-foundation",
  "main": "./worker/index.js",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
