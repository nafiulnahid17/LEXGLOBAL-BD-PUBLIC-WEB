{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lexglobalbd-public-foundation",
  "main": "./worker/index.js",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "PUBLIC_AI_RATE",
      "namespace_id": "198417",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ],
  "vars": {
    "LEGAL_SEARCH_INSTANCE": "",
    "AI_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    "VERCEL_AI_MODEL": "google/gemini-2.5-flash"
  }
}
