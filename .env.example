# This is documentation only; do NOT commit actual credentials.
# Cloudflare AI binding is faster and needs NO API token inside the Worker.
# Only for optional REST mode:
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_AI_USE_REST=false
# Set CF_AI_API_TOKEN with `npx wrangler secret put CF_AI_API_TOKEN`
# Create a Cloudflare AI Search instance with verified sources, then set this non-secret value in wrangler.jsonc:
LEGAL_SEARCH_INSTANCE=your_verified_ai_search_instance
AI_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
AI_GATEWAY_ID=default
