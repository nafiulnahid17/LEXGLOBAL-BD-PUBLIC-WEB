# Cloudflare Workers AI Binding only — no AI API tokens or REST endpoints.
# Binding: wrangler.jsonc -> { "ai": { "binding": "AI" } }
# Optional, non-secret configuration is set in wrangler.jsonc vars:
# LEGAL_SEARCH_INSTANCE = <your verified legal AI Search instance name>
# AI_MODEL = @cf/qwen/qwen3-30b-a3b-fp8
# Credentials are not required inside the Worker for model inference.
